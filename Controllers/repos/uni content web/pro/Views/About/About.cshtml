@{
    ViewData["Title"] = "About Us";
}

<div class="container about-page">

    <h1 class="about-title">About IOAE University</h1>

    <p class="about-subtitle">
        IOAE University is committed to excellence in education, research, and innovation.
    </p>

    <!-- Intro Section -->
    <div class="about-intro">
        <img src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1200&q=60" />
        <div>
            <h2>Who We Are</h2>
            <p>
                IOAE University has been a center of academic excellence, shaping students into future leaders.
                Our mission is to provide world-class education while encouraging innovation and creativity.
            </p>
        </div>
    </div>

    <!-- Mission & Vision -->
    <div class="mv-grid">

        <div class="mv-box">
            <h3>Our Mission</h3>
            <p>
                To empower students through high-quality education and to contribute to society through
                pioneering research.
            </p>
        </div>

        <div class="mv-box">
            <h3>Our Vision</h3>
            <p>
                To be a globally recognized institution that nurtures talent and fosters intellectual growth.
            </p>
        </div>

    </div>

    <!-- Stats -->
    <div class="stats-grid">

        <div class="stat-box">
            <h2>5000+</h2>
            <p>Students Enrolled</p>
        </div>

        <div class="stat-box">
            <h2>150+</h2>
            <p>Academic Programs</p>
        </div>

        <div class="stat-box">
            <h2>300+</h2>
            <p>Faculty Members</p>
        </div>

        <div class="stat-box">
            <h2>50+</h2>
            <p>Years of Excellence</p>
        </div>

    </div>

</div>
