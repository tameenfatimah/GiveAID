@{
    ViewData["Title"] = "Admissions";
}

<div class="container admissions-page">

    <h1 class="admission-title">Admissions</h1>
    <p class="admission-subtitle">
        Begin your academic journey at IOAE University. Select a program below or fill out the admission form.
    </p>

    <!-- UG & PG Sections -->
    <div class="admission-sections">

        <div class="ad-box">
            <h2>Undergraduate Programs</h2>
            <p>
                Explore our diverse undergraduate degrees designed to shape your academic foundation and future career.
            </p>
            <a asp-controller="Academics" asp-action="Undergraduate" class="ad-link">View Undergraduate Programs →</a>
        </div>

        <div class="ad-box">
            <h2>Postgraduate Programs</h2>
            <p>
                Advance your career through specialized postgraduate degrees built on research and innovation.
            </p>
            <a asp-controller="Academics" asp-action="Postgraduate" class="ad-link">View Postgraduate Programs →</a>
        </div>

    </div>

    <hr class="ad-divider" />

    <!-- Admission Form -->
    <h2 class="form-title">Admission Form</h2>

    <form method="post" class="admission-form">

        <div class="form-group">
            <label>Full Name</label>
            <input type="text" name="FullName" class="form-control" required />
        </div>

        <div class="form-group">
            <label>Email Address</label>
            <input type="email" name="Email" class="form-control" required />
        </div>

        <div class="form-group">
            <label>Phone Number</label>
            <input type="text" name="Phone" class="form-control" required />
        </div>

        <div class="form-group">
            <label>Program Type</label>
            <select name="ProgramType" class="form-control" required>
                <option value="">-- Select --</option>
                <option>Undergraduate</option>
                <option>Postgraduate</option>
            </select>
        </div>

        <div class="form-group">
            <label>Intended Faculty</label>
            <select name="Faculty" class="form-control" required>
                <option value="">-- Select --</option>
                <option>Medical</option>
                <option>Law</option>
                <option>Engineering</option>
                <option>Business</option>
                <option>Arts</option>
            </select>
        </div>

        <div class="form-group">
            <label>Message / Additional Info</label>
            <textarea name="Message" class="form-control" rows="4"></textarea>
        </div>

        <button type="submit" class="btn-submit">Submit Application</button>
    </form>

</div>
