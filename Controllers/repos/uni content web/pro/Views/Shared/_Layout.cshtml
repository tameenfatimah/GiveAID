<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Institute</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" />

</head>
<body>

    <!-- ================= NAVBAR ================= -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">IOAE</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <!-- Academics dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Academics</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Academics" asp-action="Undergraduate">Undergraduate</a></li>
                                <li><a class="dropdown-item" asp-controller="Academics" asp-action="Postgraduate">Postgraduate</a></li>
                            </ul>
                        </li>

                        <!-- Faculties dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Faculties</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Faculty" asp-action="Law">Law</a></li>
                                <li><a class="dropdown-item" asp-controller="Faculty" asp-action="Arts">Arts</a></li>
                                <li><a class="dropdown-item" asp-controller="Faculty" asp-action="Engineering">Engineering</a></li>
                                <li><a class="dropdown-item" asp-controller="Faculty" asp-action="Business">Business</a></li>
                                <li><a class="dropdown-item" asp-controller="Faculty" asp-action="Medical">Medical</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Library" asp-action="Library">Library</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="About" asp-action="About">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Contact">Contact</a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <!-- ========================================== -->
    <!-- MAIN CONTENT FROM VIEW -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="border-top footer text-muted py-3 mt-4">
        <div class="container">
            &copy; 2025 - Institute
        </div>
    </footer>

</body>
</html>
