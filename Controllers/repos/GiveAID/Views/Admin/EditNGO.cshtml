@model GiveAID.Models.NGO
@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit NGO";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_5.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">
                    <span class="mr-2"><a href="@Url.Action("Dashboard", "Admin")">Dashboard</a></span>
                    <span class="mr-2"><a href="@Url.Action("ManageNGOs", "Admin")">NGOs</a></span>
                    <span>Edit NGO</span>
                </p>
                <h1 class="mb-3 bread" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">Edit NGO</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger ftco-animate">@ViewBag.Error</div>
                }

                <form method="post" action="@Url.Action("EditNGO", "Admin", new { id = Model.NGOId })"
                      enctype="multipart/form-data" class="ftco-animate">

                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">NGO Name *</label>
                        <input type="text" name="name" class="form-control" value="@Model.Name" required />
                    </div>
                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Description</label>
                        <textarea name="description" class="form-control" rows="4">@Model.Description</textarea>
                    </div>
                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Contact Email</label>
                        <input type="email" name="contactEmail" class="form-control" value="@Model.ContactEmail" />
                    </div>
                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Contact Phone</label>
                        <input type="text" name="contactPhone" class="form-control" value="@Model.ContactPhone" />
                    </div>
                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Website</label>
                        <input type="text" name="website" class="form-control" value="@Model.Website" />
                    </div>
                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Current Logo</label><br />
                        <img src="@Model.LogoPath" style="width:80px; height:80px; object-fit:cover; border-radius:50%; margin-bottom:10px;" /><br />
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Upload New Logo (optional)</label>
                        <input type="file" name="logoFile" class="form-control" accept="image/*" />
                    </div>
                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Status</label><br />
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="isActive" value="true"
                                   @(Model.IsActive ? "checked" : "") />
                            <label class="form-check-label">Active (visible on website)</label>
                        </div>
                    </div>
                    <div class="form-group mt-4">
                        <input type="submit" value="Save Changes" class="btn btn-primary py-3 px-5" />
                        <a href="@Url.Action("ManageNGOs", "Admin")" class="btn btn-outline-primary py-3 px-4 ml-2">Cancel</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</section>