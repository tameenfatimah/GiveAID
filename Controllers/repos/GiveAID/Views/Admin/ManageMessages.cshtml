@model List<GiveAID.Models.ContactMessage>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Contact Messages";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_2.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">
                    <span class="mr-2"><a href="@Url.Action("Dashboard", "Admin")">Dashboard</a></span>
                    <span>Contact Messages</span>
                </p>
                <h1 class="mb-3 bread" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">Contact Messages</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <div class="row justify-content-between align-items-center mb-4">
            <div class="col-md-8 heading-section ftco-animate">
                <span class="subheading">Admin Panel</span>
                <h2>All Contact Messages</h2>
            </div>
            <div class="col-md-4 ftco-animate text-right">
                <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-primary py-2 px-4">&larr; Dashboard</a>
            </div>
        </div>

        @foreach (var m in Model)
        {
            <div class="row ftco-animate mb-4">
                <div class="col-md-12">
                    <div style="border:1px solid #f2f2f2; border-radius:4px; padding:25px;
                                    box-shadow:0px 3px 66px -24px rgba(0,0,0,0.2); background:#fff;
                                    border-left: 4px solid @(m.IsRead ? "#dee2e6" : "#f86f2d");">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 style="font-family:'Dosis',sans-serif; color:#000; margin:0;">@m.Subject</h5>
                                <small style="color:gray;">From: <strong>@m.FullName</strong> — @m.Email</small>
                            </div>
                            @if (!m.IsRead)
                            {
                                <span style="background:#f86f2d; color:#fff; padding:4px 14px; border-radius:30px; font-size:13px;">New</span>
                            }
                            else
                            {
                                <span style="background:#dee2e6; color:gray; padding:4px 14px; border-radius:30px; font-size:13px;">Read</span>
                            }
                        </div>
                        <p style="color:gray;">@m.Message</p>
                        <small style="color:#bfbfbf;">Received: @m.SubmittedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                        <div class="mt-3">
                            @if (!m.IsRead)
                            {
                                <a href="@Url.Action("MarkAsRead", "Admin", new { id = m.ContactMessageId })"
                                   class="btn btn-outline-primary py-1 px-3 mr-2">Mark as Read</a>
                            }
                            <a href="@Url.Action("DeleteMessage", "Admin", new { id = m.ContactMessageId })"
                               class="btn btn-outline-primary py-1 px-3"
                               onclick="return confirm('Delete this message?')">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</section>