@model List<GiveAID.Models.Gallery>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Gallery";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_5.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">
                    <span class="mr-2"><a href="@Url.Action("Dashboard", "Admin")">Dashboard</a></span>
                    <span>Manage Gallery</span>
                </p>
                <h1 class="mb-3 bread" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">Manage Gallery</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <div class="row justify-content-between align-items-center mb-4">
            <div class="col-md-8 heading-section ftco-animate">
                <span class="subheading">Admin Panel</span>
                <h2>Gallery Images</h2>
            </div>
            <div class="col-md-4 ftco-animate text-right">
                <a href="@Url.Action("UploadImage", "Admin")" class="btn btn-primary py-2 px-4 mr-2">+ Upload Image</a>
                <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-primary py-2 px-4">&larr; Dashboard</a>
            </div>
        </div>

        <div class="row ftco-animate">
            @foreach (var img in Model)
            {
                <div class="col-md-3 mb-4">
                    <div style="border:1px solid #f2f2f2; border-radius:4px; overflow:hidden; box-shadow:0px 3px 66px -24px rgba(0,0,0,0.2);">
                        <img src="@img.ImagePath" alt="@img.Caption"
                             style="width:100%; height:180px; object-fit:cover;" />
                        <div class="p-3">
                            <p style="color:#000; font-family:'Dosis',sans-serif; margin-bottom:4px;">
                                <strong>@img.Caption</strong>
                            </p>
                            <p style="color:gray; font-size:13px; margin-bottom:8px;">@img.Category</p>
                            <a href="@Url.Action("DeleteImage", "Admin", new { id = img.GalleryId })"
                               class="btn btn-outline-primary py-1 px-3"
                               onclick="return confirm('Delete this image?')">Delete</a>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>