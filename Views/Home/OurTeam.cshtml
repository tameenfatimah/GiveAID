@{
    Layout = "_Layout";
    ViewData["Title"] = "Our Team";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_5.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }"><span class="mr-2"><a href="@Url.Action("Index", "Home")">Home</a></span><span class="mr-2"><a href="@Url.Action("About", "Home")">About</a></span><span>Our Team</span></p>
                <h1 class="mb-3 bread" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">Our Team</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 heading-section ftco-animate text-center">
                <span class="subheading">The People Behind Give-AID</span>
                <h2 class="mb-4">Meet Our Team</h2>
                <p>Our dedicated team works tirelessly to connect donors with causes and make sure every contribution counts.</p>
            </div>
        </div>
        <div class="row">
            @{
                var team = new[] 
                        {
                        new { img="person_1.jpg", name="Ahmad Raza", role="Founder & CEO" },
                        new { img="person_10.jpg", name="Sara Khan", role="Operations Manager" },
                        new { img="person_3.jpg", name="Usman Tariq", role="NGO Partnerships" },
                        new { img="person_11.jpg", name="Fatima Malik", role="Community Manager" },
                        };
            }
            @foreach (var t in team)
            {
                <div class="col-md-3 ftco-animate mb-4">
                    <div class="staff text-center" style="height:300px">
                        <div class="img-staff" style="background-image: url('@Url.Content("~/images/" + t.img)'); width:120px; height:120px; border-radius:50%;background-size:cover; background-position:center; margin:0 auto 15px auto;">
                        </div>
                        <div class="info">
                            <h3 style="font-family:'Dosis',sans-serif;">@t.name</h3>
                            <span class="position" style="color:#f86f2d;">@t.role</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>