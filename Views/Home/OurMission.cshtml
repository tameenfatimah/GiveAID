@{
    Layout = "_Layout";
    ViewData["Title"] = "Our Mission";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_4.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }"><span class="mr-2"><a href="@Url.Action("Index", "Home")">Home</a></span><span class="mr-2"><a href="@Url.Action("About", "Home")">About</a></span><span>Our Mission</span></p>
                <h1 class="mb-3 bread" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">Our Mission</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">
        <div class="row">
            <div class="col-md-6 ftco-animate">
                <div class="heading-section mb-4">
                    <span class="subheading">Why We Exist</span>
                    <h2 class="mb-4">Our Mission</h2>
                </div>
                <p>Our mission is to connect generous donors with verified NGOs across Pakistan, ensuring that every donation reaches flood victims, orphans and underprivileged communities — with full transparency.</p>
                <p>We believe poverty, lack of education and healthcare are not inevitable in Pakistan. With the right platform and community — we can change millions of lives across Sindh, Balochistan, KPK and Punjab.</p>
            </div>
            <div class="col-md-6 ftco-animate">
                <div class="heading-section mb-4">
                    <span class="subheading">Where We Are Going</span>
                    <h2 class="mb-4">Our Vision</h2>
                </div>
                <p>A Pakistan where no child goes hungry, every person has access to healthcare, and every community has the resources to stand on its own feet.</p>
                <p>We envision Give-AID becoming Pakistan's most trusted welfare platform — bridging the gap between donors and hundreds of verified NGOs working across all four provinces.</p>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section bg-light">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 heading-section ftco-animate text-center">
                <span class="subheading">What Guides Us</span>
                <h2 class="mb-4">Our Core Values</h2>
            </div>
        </div>
        <div class="row">

            <div class="col-md-3 ftco-animate text-center mb-4 d-flex">
                <div class="p-4 w-100" style="border:1px solid #f2f2f2; border-radius:4px; background:#fff;">
                    <span class="flaticon-donation-1" style="font-size:40px; color:#f86f2d; display:block; margin-bottom:15px;"></span>
                    <h5>Transparency</h5>
                    <p style="color:gray; font-size:14px;">We are fully transparent about how donations are used and where they go.</p>
                </div>
            </div>

            <div class="col-md-3 ftco-animate text-center mb-4 d-flex">
                <div class="p-4 w-100" style="border:1px solid #f2f2f2; border-radius:4px; background:#fff;">
                    <span class="flaticon-charity" style="font-size:40px; color:#f86f2d; display:block; margin-bottom:15px;"></span>
                    <h5>Compassion</h5>
                    <p style="color:gray; font-size:14px;">Everything we do is driven by genuine compassion for those in need.</p>
                </div>
            </div>

            <div class="col-md-3 ftco-animate text-center mb-4 d-flex">
                <div class="p-4 w-100" style="border:1px solid #f2f2f2; border-radius:4px; background:#fff;">
                    <img src="~/images/accountability.png" style="width:45px; margin-top:23px; margin-bottom:23px"  />
                    <h5>Accountability</h5>
                    <p style="color:gray; font-size:14px;">We hold ourselves and our partner NGOs to the highest standards.</p>
                </div>
            </div>

            <div class="col-md-3 ftco-animate text-center mb-4 d-flex">
                <div class="p-4 w-100" style="border:1px solid #f2f2f2; border-radius:4px; background:#fff;">
                    <span class="flaticon-donation" style="font-size:40px; color:#f86f2d; display:block; margin-bottom:15px;"></span>
                    <h5>Impact</h5>
                    <p style="color:gray; font-size:14px;">We measure our success by the real impact we create in people's lives.</p>
                </div>
            </div>

        </div>  
    </div>
</section>