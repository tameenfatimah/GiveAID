@model GiveAID.Models.Event
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Title;
}

<div class="hero-wrap" style="background-image: url('@(string.IsNullOrEmpty(Model.ImagePath) ? Url.Content("~/images/bg_7.jpg") : Model.ImagePath)');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">
                    <span class="mr-2"><a href="@Url.Action("Index", "Home")">Home</a></span>
                    <span class="mr-2"><a href="@Url.Action("Events", "Home")">Events</a></span>
                    <span>@Model.Title</span>
                </p>
                <h1 class="mb-3 bread" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">@Model.Title</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">
        <div class="row">

            <!-- LEFT: DESCRIPTION -->
            <div class="col-md-8 ftco-animate">
                <div class="heading-section mb-4">
                    <span class="subheading">@Model.Category</span>
                    <h2 class="mb-3">@Model.Title</h2>
                </div>
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.Title"
                         style="width:100%; border-radius:4px; max-height:400px;
                                    object-fit:cover; margin-bottom:25px;" />
                }
                <p>@Model.Description</p>
                <div class="mt-4">
                    <a href="@Url.Action("Index", "Donation")" class="btn btn-primary py-3 px-5 mr-3">
                        Donate to This Cause
                    </a>
                    <a href="@Url.Action("Events", "Home")" class="btn btn-outline-primary py-3 px-4">
                        &larr; All Events
                    </a>
                </div>
            </div>

            <!-- RIGHT: INFO BOX -->
            <div class="col-md-4 ftco-animate">
                <div class="p-4" style="background:#f8f9fa; border-radius:4px; border-left:4px solid #f86f2d;">
                    <h5 style="font-family:'Dosis',sans-serif; color:#f86f2d; margin-bottom:20px;">
                        Event Information
                    </h5>
                    <p>
                        <span class="icon-calendar mr-2" style="color:#f86f2d;"></span>
                        <strong>Date:</strong> @Model.EventDate.ToString("dd MMMM yyyy")
                    </p>
                    <p>
                        <span class="icon-map-o mr-2" style="color:#f86f2d;"></span>
                        <strong>Location:</strong> @Model.Location
                    </p>
                    <p>
                        <span class="icon-tag mr-2" style="color:#f86f2d;"></span>
                        <strong>Category:</strong> @Model.Category
                    </p>
                    <p>
                        <strong>Status:</strong>
                        @if (Model.IsUpcoming)
                        {
                            <span style="background:#f86f2d; color:#fff; padding:3px 10px; border-radius:30px; font-size:12px;">Upcoming</span>
                        }
                        else
                        {
                            <span style="background:gray; color:#fff; padding:3px 10px; border-radius:30px; font-size:12px;">Past Event</span>
                        }
                    </p>
                    <hr />
                    <a href="@Url.Action("HelpCentre", "Home")" class="btn btn-outline-primary py-2 px-4">
                        Ask a Question
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>