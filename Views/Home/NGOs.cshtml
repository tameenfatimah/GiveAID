@model List<GiveAID.Models.NGO>
@{
    Layout = "_Layout";
    ViewData["Title"] = "NGOs";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_2.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs"><span class="mr-2"><a href="@Url.Action("Index","Home")">Home</a></span> <span>Causes</span></p>
                <h1 class="mb-3 bread">Our Causes</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 heading-section ftco-animate text-center">
                <span class="subheading">What We Support</span>
                <h2 class="mb-4">Our NGOs & Causes</h2>
                <p>Support any of our verified NGOs and make a real difference today.</p>
            </div>
        </div>
        <div class="row">
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var ngo in Model)
                {
                    <div class="col-md-4 ftco-animate mb-4">
                        <div class="p-4 text-center" style="border:1px solid #f2f2f2; border-radius:4px; box-shadow:0px 3px 66px -24px rgba(0,0,0,0.2);">
                            @if (!string.IsNullOrEmpty(ngo.LogoPath))
                            {
                                <img src="@ngo.LogoPath" alt="@ngo.Name"
                                     style="width:80px; height:80px; object-fit:contain; border-radius:50%; margin-bottom:15px;" />
                            }
                            else
                            {
                                <div style="width:80px; height:80px; background:#f86f2d; border-radius:50%; margin:0 auto 15px auto; display:flex; align-items:center; justify-content:center;">
                                    <span class="flaticon-charity" style="font-size:30px; color:#fff;"></span>
                                </div>
                            }
                            <h5 style="font-family:'Dosis',sans-serif;">@ngo.Name</h5>
                            <p style="color:gray; font-size:14px;">@(ngo.Description != null && ngo.Description.Length > 100 ? ngo.Description.Substring(0, 100) + "..." : ngo.Description)</p>
                            @if (!string.IsNullOrEmpty(ngo.ContactEmail))
                            {
                                <p style="color:gray; font-size:13px;"><span class="icon-envelope mr-1"></span> @ngo.ContactEmail</p>
                            }
                            <a href="@Url.Action("Index","Donation")" class="btn btn-primary py-2 px-4 mt-2">
                                Donate to this Cause
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-md-12 ftco-animate text-center">
                    <p style="color:gray;">No NGOs listed yet. Check back soon!</p>
                    <a href="@Url.Action("Index","Home")" class="btn btn-primary py-3 px-5">Back to Home</a>
                </div>
            }
        </div>
    </div>
</section>