@{
    Layout = "_Layout";
    ViewData["Title"] = "Our Supporters";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }"><span class="mr-2"><a href="@Url.Action("Index", "Home")">Home</a></span><span>Our Supporters</span></p>
                <h1 class="mb-3 bread" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">Our Supporters</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 heading-section ftco-animate text-center">
                <span class="subheading">Those Who Believe In Us</span>
                <h2 class="mb-4">Our Supporters</h2>
                <p>We are grateful for the individuals, organizations and companies who make our work possible.</p>
            </div>
        </div>

        <div class="row justify-content-center mb-5">
            @{
                var supporters = new[] 
                        {
                        new { img="person_12.jpg", name="Ali Hassan", type="Individual Donor" },
                        new { img="person_6.jpg", name="Mohd. Ahmed", type="Monthly Donor" },
                        new { img="person_13.jpg", name="Kamran Sheikh", type="Gold Sponsor" },
                        new { img="person_4.jpg", name="Shehzad Amir", type="Individual Donor" },
                        };
            }
            @foreach (var s in supporters)
            {
                <div class="col-md-3 ftco-animate text-center mb-4">
                    <div style="background-image: url('@Url.Content("~/images/" + s.img)');width:100px; height:100px; border-radius:50%;background-size:cover; background-position:center;margin:0 auto 15px auto;">
                    </div>
                    <h5 style="font-family:'Dosis',sans-serif;">@s.name</h5>
                    <span style="color:#f86f2d; font-size:13px;">@s.type</span>
                </div>
            }
        </div>
        <div class="row justify-content-center ftco-animate">
            <div class="col-md-7 text-center">
                <p style="color:gray;">Want to become a supporter? Start by making a donation today.</p>
                <a href="@Url.Action("Index", "Donation")" class="btn btn-primary py-3 px-5 mr-3">Donate Now</a>
                <a href="@Url.Action("Partners", "Home")" class="btn btn-outline-primary py-3 px-5">Our Partners</a>
            </div>
        </div>
    </div>
</section>