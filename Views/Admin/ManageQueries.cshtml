@model List<GiveAID.Models.Query>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Queries";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_7.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">
                    <span class="mr-2"><a href="@Url.Action("Dashboard", "Admin")">Dashboard</a></span>
                    <span>Manage Queries</span>
                </p>
                <h1 class="mb-3 bread" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">User Queries</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <div class="row justify-content-between align-items-center mb-4">
            <div class="col-md-8 heading-section ftco-animate">
                <span class="subheading">Admin Panel</span>
                <h2>All User Queries</h2>
            </div>
            <div class="col-md-4 ftco-animate text-right">
                <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-primary py-2 px-4">&larr; Dashboard</a>
            </div>
        </div>

        @foreach (var q in Model)
        {
            <div class="row ftco-animate mb-4">
                <div class="col-md-12">
                    <div style="border:1px solid #f2f2f2; border-radius:4px; padding:25px; box-shadow:0px 3px 66px -24px rgba(0,0,0,0.2); background:#fff;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 style="font-family:'Dosis',sans-serif; color:#000; margin:0;">
                                @q.Subject
                                <small style="color:gray; font-size:13px; font-family:'Overpass',sans-serif;">
                                    — User ID: @q.UserId
                                </small>
                            </h5>
                            @if (q.IsRepliedAt)
                            {
                                <span style="background:#28a745; color:#fff; padding:4px 14px; border-radius:30px; font-size:13px;">✓ Replied</span>
                            }
                            else
                            {
                                <span style="background:#f86f2d; color:#fff; padding:4px 14px; border-radius:30px; font-size:13px;">⏳ Pending</span>
                            }
                        </div>
                        <p style="color:gray;">@q.Message</p>
                        <small style="color:#bfbfbf;">Submitted: @q.SubmittedAt.ToString("dd MMM yyyy, hh:mm tt")</small>

                        @if (q.IsRepliedAt)
                        {
                            <div style="background:#f8f9fa; border-left:4px solid #28a745; padding:12px 16px; border-radius:0 4px 4px 0; margin-top:15px;">
                                <strong style="color:#28a745;">Your Reply:</strong>
                                <p style="margin:5px 0 0 0; color:gray;">@q.AdminReply</p>
                            </div>
                        }
                        else
                        {
                            <div class="mt-3">
                                <a href="@Url.Action("ReplyQuery", "Admin", new { id = q.QueryId })"
                                   class="btn btn-primary py-2 px-4">Reply to this Query</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

    </div>
</section>