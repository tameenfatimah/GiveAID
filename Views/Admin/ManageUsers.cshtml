@model List<GiveAID.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Users";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row justify-content-between align-items-center mb-4">
    <div class="col-md-8 heading-section">
        <span class="subheading">Admin Panel</span>
        <h2>All Registered Members</h2>
    </div>
    <div class="col-md-4  text-right">
        <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-primary py-2 px-4">&larr; Dashboard</a>
    </div>
</div>

<div class="row ">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr style="color:#f86f2d; font-family:'Dosis',sans-serif;">
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Registered</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int count = 1;
                    }
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@count</td>
                            <td>@u.Name</td>
                            <td>@u.Email</td>
                            <td>@u.Phone</td>
                            <td>
                                @if (u.Role == "Admin")
                                {
                                    <span style="background:#f86f2d; color:#fff; padding:3px 10px; border-radius:30px; font-size:12px;">Admin</span>
                                }
                                else
                                {
                                    <span style="background:#28a745; color:#fff; padding:3px 10px; border-radius:30px; font-size:12px;">User</span>
                                }
                            </td>
                            <td>@u.RegisteredAt.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (u.UserId.ToString() != Context.Session.GetString("UserId"))
                                {
                                    <a href="@Url.Action("DeleteUser", "Admin", new { id = u.UserId })"
                                       class="btn btn-outline-primary py-1 px-3"
                                       onclick="return confirm('Delete this user?')">Delete</a>
                                }
                                else
                                {
                                    <span style="color:gray; font-size:12px;">You</span>
                                }
                            </td>
                        </tr>
                        count++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>