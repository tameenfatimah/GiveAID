@model List<GiveAID.Models.User>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Users";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_2.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">
                    <span class="mr-2"><a href="@Url.Action("Dashboard", "Admin")">Dashboard</a></span>
                    <span>Manage Users</span>
                </p>
                <h1 class="mb-3 bread" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">Manage Users</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="row justify-content-between align-items-center mb-4">
            <div class="col-md-8 heading-section ftco-animate">
                <span class="subheading">Admin Panel</span>
                <h2>All Registered Members</h2>
            </div>
            <div class="col-md-4 ftco-animate text-right">
                <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-primary py-2 px-4">
                    &larr; Back to Dashboard
                </a>
            </div>
        </div>

        <div class="row ftco-animate">
            <div class="col-md-12">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr style="color:#f86f2d; font-family:'Dosis',sans-serif;">
                                <th>#</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Role</th>
                                <th>Registered</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 1;
                            }
                            @foreach (var u in Model)
                            {
                                <tr>
                                    <td>@count</td>
                                    <td>@u.Name</td>
                                    <td>@u.Email</td>
                                    <td>@u.Phone</td>
                                    <td>
                                        @if (u.Role == "Admin")
                                        {
                                            <span style="background:#f86f2d; color:#fff; padding:3px 10px; border-radius:30px; font-size:12px;">Admin</span>
                                        }
                                        else
                                        {
                                            <span style="background:#28a745; color:#fff; padding:3px 10px; border-radius:30px; font-size:12px;">User</span>
                                        }
                                    </td>
                                    <td>@u.RegisteredAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <a href="@Url.Action("DeleteUser", "Admin", new { id = u.UserId })"
                                           class="btn btn-outline-primary py-1 px-3"
                                           onclick="return confirm('Are you sure you want to delete this user?')">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>