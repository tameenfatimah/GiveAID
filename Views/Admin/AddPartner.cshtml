@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Partner";
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <form method="post" action="@Url.Action("AddPartner", "Admin")" enctype="multipart/form-data">
            <div class="form-group">
                <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Company Name *</label>
                <input type="text" name="companyName" class="form-control" placeholder="Company Name" required />
            </div>
            <div class="form-group">
                <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Description</label>
                <textarea name="description" class="form-control" rows="3" placeholder="Brief description of the partnership"></textarea>
            </div>
            <div class="form-group">
                <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Website</label>
                <input type="text" name="website" class="form-control" placeholder="https://www.company.com" />
            </div>
            <div class="form-group">
                <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Company Logo</label>
                <input type="file" name="logoFile" class="form-control" accept="image/*" />
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Add Partner" class="btn btn-primary py-3 px-5" />
                <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-primary py-3 px-4 ml-2">Cancel</a>
            </div>
        </form>
    </div>
</div>