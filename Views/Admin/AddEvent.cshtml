@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Event";
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <form method="post" action="@Url.Action("AddEvent", "Admin")" enctype="multipart/form-data">
            <div class="form-group">
                <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Event Title *</label>
                <input type="text" name="title" class="form-control" placeholder="Event Title" required />
            </div>
            <div class="form-group">
                <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Description</label>
                <textarea name="description" class="form-control" rows="4" placeholder="Describe the event"></textarea>
            </div>
            <div class="form-group">
                <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Category</label>
                <select name="category" class="form-control">
                    <option value="">-- Select Category --</option>
                    <option value="Education">Education</option>
                    <option value="Health Care">Health Care</option>
                    <option value="Children">Children</option>
                    <option value="Women">Women</option>
                    <option value="Youth">Youth</option>
                    <option value="General">General</option>
                </select>
            </div>
            <div class="form-group">
                <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Location</label>
                <input type="text" name="location" class="form-control" placeholder="Event Location" />
            </div>
            <div class="form-group">
                <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Event Date *</label>
                <input type="date" name="eventDate" class="form-control" required />
            </div>
            <div class="form-group">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="isUpcoming" value="true" checked />
                    <label class="form-check-label">Mark as Upcoming Event</label>
                </div>
            </div>
            <div class="form-group">
                <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Event Banner Image</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Add Event" class="btn btn-primary py-3 px-5" />
                <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-primary py-3 px-4 ml-2">Cancel</a>
            </div>
        </form>
    </div>
</div>