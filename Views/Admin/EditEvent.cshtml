@model GiveAID.Models.Event
@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Event";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_4.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">
                    <span class="mr-2"><a href="@Url.Action("Dashboard", "Admin")">Dashboard</a></span>
                    <span class="mr-2"><a href="@Url.Action("ManageEvents", "Admin")">Events</a></span>
                    <span>Edit Event</span>
                </p>
                <h1 class="mb-3 bread" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">Edit Event</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger ftco-animate">@ViewBag.Error</div>
                }

                <form method="post" action="@Url.Action("EditEvent", "Admin", new { id = Model.EventId })"
                      enctype="multipart/form-data" class="ftco-animate">

                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Event Title *</label>
                        <input type="text" name="title" class="form-control" value="@Model.Title" required />
                    </div>
                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Description</label>
                        <textarea name="description" class="form-control" rows="4">@Model.Description</textarea>
                    </div>
                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Category</label>
                        <select name="category" class="form-control">
                            <option value="Education" @(Model.Category == "Education" ? "selected" : "")>Education</option>
                            <option value="Health Care" @(Model.Category == "Health Care" ? "selected" : "")>Health Care</option>
                            <option value="Children" @(Model.Category == "Children" ? "selected" : "")>Children</option>
                            <option value="Women" @(Model.Category == "Women" ? "selected" : "")>Women</option>
                            <option value="Youth" @(Model.Category == "Youth" ? "selected" : "")>Youth</option>
                            <option value="General" @(Model.Category == "General" ? "selected" : "")>General</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Location</label>
                        <input type="text" name="location" class="form-control" value="@Model.Location" />
                    </div>
                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Event Date *</label>
                        <input type="date" name="eventDate" class="form-control"
                               value="@Model.EventDate.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="form-group">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="isUpcoming"
                                   value="true" @(Model.IsUpcoming ? "checked" : "") />
                            <label class="form-check-label">Mark as Upcoming Event</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Current Image</label><br />
                        <img src="@Model.ImagePath" style="width:120px; height:80px; object-fit:cover; border-radius:4px; margin-bottom:10px;" /><br />
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Upload New Image (optional)</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    </div>
                    <div class="form-group mt-4">
                        <input type="submit" value="Save Changes" class="btn btn-primary py-3 px-5" />
                        <a href="@Url.Action("ManageEvents", "Admin")" class="btn btn-outline-primary py-3 px-4 ml-2">Cancel</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</section>