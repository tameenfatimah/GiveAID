@model GiveAID.Models.Query
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reply to Query";
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="mb-5" style="background:#f8f9fa; border-left:4px solid #f86f2d; padding:20px 25px; border-radius:0 4px 4px 0;">
            <h5 style="font-family:'Dosis',sans-serif; color:#000;">@Model.Subject</h5>
            <p style="color:gray; margin-bottom:8px;">@Model.Message</p>
            <small style="color:#bfbfbf;">Submitted: @Model.SubmittedAt.ToString("dd MMM yyyy, hh:mm tt") | User ID: @Model.UserId</small>
        </div>

        <form method="post" action="@Url.Action("ReplyQuery", "Admin", new { id = Model.QueryId })">
            <div class="heading-section mb-4">
                <span class="subheading">Your Response</span>
                <h2>Write Your Reply</h2>
            </div>
            <div class="form-group">
                <textarea name="adminReply" class="form-control" rows="6" placeholder="Type your reply here..." required></textarea>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Send Reply" class="btn btn-primary py-3 px-5" />
                <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-primary py-3 px-4 ml-2">Cancel</a>
            </div>
        </form>
    </div>
</div>