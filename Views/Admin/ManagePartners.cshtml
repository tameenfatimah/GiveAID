@model List<GiveAID.Models.Partner>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Partners";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row justify-content-between align-items-center mb-4">
    <div class="col-md-8 heading-section">
        <span class="subheading">Admin Panel</span>
        <h2>All Partners</h2>
    </div>
    <div class="col-md-4 text-right">
        <a href="@Url.Action("AddPartner", "Admin")" class="btn btn-primary py-2 px-4 mr-2">+ Add Partner</a>
        <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-primary py-2 px-4">&larr; Dashboard</a>
    </div>
</div>

<div class="row ">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr style="color:#f86f2d; font-family:'Dosis',sans-serif;">
                        <th>#</th>
                        <th>Logo</th>
                        <th>Company Name</th>
                        <th>Website</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int count = 1;
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@count</td>
                            <td><img src="@p.LogoPath" style="width:50px; height:50px; object-fit:cover; border-radius:50%;" /></td>
                            <td><strong>@p.CompanyName</strong></td>
                            <td><a href="@p.Website" target="_blank" style="color:#f86f2d;">@p.Website</a></td>
                            <td>@(p.IsActive ? "Active" : "Inactive")</td>
                            <td>
                                <a href="@Url.Action("EditPartner", "Admin", new { id = p.PartnerId })" class="btn btn-outline-primary py-1 px-3 mr-1">Edit</a>
                                <a href="@Url.Action("DeletePartner", "Admin", new { id = p.PartnerId })" class="btn btn-outline-primary py-1 px-3" onclick="return confirm('Delete this partner?')">Delete</a>
                            </td>
                        </tr>
                        count++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>