@{
    Layout = "_Layout";
    ViewData["Title"] = "Change Password";
}

<!-- ─── HERO BANNER ─── -->
<div class="hero-wrap" style="background-image: url('~/images/bg_5.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center" data-scrollax="properties: { translateY: '70%' }">
                <p class="breadcrumbs" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">
                    <span class="mr-2"><a href="/Home/Index">Home</a></span>
                    <span class="mr-2"><a href="/User/Profile">Profile</a></span>
                    <span>Change Password</span>
                </p>
                <h1 class="mb-3 bread" data-scrollax="properties: { translateY: '30%', opacity: 1.6 }">
                    Change Password
                </h1>
            </div>
        </div>
    </div>
</div>

<!-- ─── MAIN CONTENT ─── -->
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">

                <div class="row justify-content-center mb-5">
                    <div class="col-md-12 heading-section ftco-animate text-center">
                        <span class="subheading">Account Security</span>
                        <h2 class="mb-2">Update Your Password</h2>
                        <p>Choose a strong password with at least 6 characters.</p>
                    </div>
                </div>

                @* ── MESSAGES ── *@
                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success ftco-animate">@ViewBag.Success</div>
                }
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger ftco-animate">@ViewBag.Error</div>
                }

                <form method="post" action="/User/ChangePassword" class="ftco-animate">

                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Current Password *</label>
                        <input type="password"
                               name="currentPassword"
                               class="form-control"
                               placeholder="Enter your current password"
                               required />
                    </div>

                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">New Password *</label>
                        <input type="password"
                               name="newPassword"
                               class="form-control"
                               placeholder="Enter new password"
                               required
                               minlength="6" />
                        <small style="color:gray;">Minimum 6 characters.</small>
                    </div>

                    <div class="form-group">
                        <label style="color:#f86f2d; font-family:'Dosis',sans-serif;">Confirm New Password *</label>
                        <input type="password"
                               name="confirmNewPassword"
                               class="form-control"
                               placeholder="Re-enter new password"
                               required
                               minlength="6" />
                    </div>

                    <div class="form-group mt-4">
                        <input type="submit"
                               value="Update Password"
                               class="btn btn-primary py-3 px-5" />
                        <a href="/User/Profile"
                           class="btn btn-outline-primary py-3 px-4 ml-2">Cancel</a>
                    </div>

                </form>

            </div>
        </div>
    </div>
</section>