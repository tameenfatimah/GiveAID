@{
    Layout = "_Layout";
    ViewData["Title"] = "Register";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center">
                <p class="breadcrumbs"><span class="mr-2"><a href="@Url.Action("Index", "Home")">Home</a></span><span>Register</span></p>
                <h1 class="mb-3 bread">Create an Account</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">

                <div class="row justify-content-center mb-5">
                    <div class="col-md-12 heading-section ftco-animate text-center">
                        <span class="subheading">Join Us Today</span>
                        <h2 class="mb-2">Create Your Account</h2>
                        <p>Register to donate, track your contributions and make a real difference.</p>
                    </div>
                </div>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form method="post" action="@Url.Action("Register","User")" class="ftco-animate">
                    <h5 class="mb-3" style="color:#f86f2d; font-family:'Dosis',sans-serif;">Personal Information</h5>

                    <div class="form-group">
                        <input type="text" name="name" class="form-control" placeholder="Full Name *" required />
                    </div>
                    <div class="form-group">
                        <input type="email" name="email" class="form-control" placeholder="Email Address *" required />
                    </div>
                    <div class="form-group">
                        <input type="text" name="phone" class="form-control" placeholder="Phone Number *" required />
                    </div>
                    <div class="form-group">
                        <textarea name="address" class="form-control" rows="2" placeholder="Home Address"></textarea>
                    </div>
                    <h5 class="mb-3 mt-4" style="color:#f86f2d; font-family:'Dosis',sans-serif;">Professional Information</h5>

                    <div class="form-group">
                        <input type="text" name="profession" class="form-control" placeholder="Your Profession (e.g. Engineer, Teacher)" />
                    </div>
                    <h5 class="mb-3 mt-4" style="color:#f86f2d; font-family:'Dosis',sans-serif;">Set Password</h5>

                    <div class="form-group">
                        <input type="password" name="password" class="form-control" placeholder="Password * (min 6 characters)" required minlength="6" />
                    </div>
                    <div class="form-group">
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm Password *" required minlength="6" />
                    </div>
                    <div class="form-group mt-4">
                        <input type="submit" value="Create Account" class="btn btn-primary py-3 px-5" />
                    </div>

                    <p class="mt-3 text-center">Already have an account?
                        <a href="@Url.Action("Login", "User")" style="color:#f86f2d;">Login here</a></p>
                </form>
            </div>
        </div>
    </div>
</section>
