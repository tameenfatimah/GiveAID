@model List<GiveAID.Models.Query>
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Queries";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_7.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center">
                <p class="breadcrumbs"><span class="mr-2"><a href="@Url.Action("Index", "Home")">Home</a></span><span>My Queries</span></p>
                <h1 class="mb-3 bread">My Queries</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">

        <div class="row justify-content-center mb-5">
            <div class="col-md-8 heading-section ftco-animate text-center">
                <span class="subheading">Help Centre</span>
                <h2 class="mb-2">Your Submitted Queries</h2>
                <p>Track all your queries and see replies from our team below.</p>
            </div>
        </div>

        <div class="row justify-content-end mb-4">
            <div class="col-md-12 ftco-animate text-right">
                <a href="@Url.Action("HelpCentre", "Home")" class="btn btn-primary py-3 px-5">+ Submit New Query</a>
            </div>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            @foreach (var q in Model)
            {
                <div class="row ftco-animate mb-4">
                    <div class="col-md-12">
                        <div style="border:1px solid #f2f2f2; border-radius:4px; box-shadow:0px 3px 66px -24px rgba(0,0,0,0.2);background:#fff; padding:30px;">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 style="font-family:'Dosis',sans-serif; color:#000; margin:0;">@q.Subject</h5>
                                @if (q.IsRepliedAt)
                                {
                                    <span style="background:#28a745; color:#fff; padding:4px 14px; border-radius:30px; font-size:13px;">Replied</span>
                                }
                                else
                                {
                                    <span style="background:#f86f2d; color:#fff; padding:4px 14px; border-radius:30px; font-size:13px;">Pending</span>
                                }
                            </div>

                            <p style="color:gray; margin-bottom:8px;">
                                <strong style="color:#000;">Your Message:</strong><br />@q.Message</p>
                            <p><small style="color:#bfbfbf;">Submitted on: @q.SubmittedAt.ToString("dd MMM yyyy, hh:mm tt")</small></p>

                            @if (q.IsRepliedAt && q.AdminReply != null)
                            {
                                <hr />
                                <div style="background:#f8f9fa; border-left:4px solid #f86f2d; padding:15px 20px; border-radius:0 4px 4px 0;">
                                    <p style="margin:0; color:#000;"><strong style="color:#f86f2d;">Team Reply:</strong><br />@q.AdminReply</p>
                                    <small style="color:#bfbfbf;">Replied on: @q.RepliedAt?.ToString("dd MMM yyyy, hh:mm tt")</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="row ftco-animate justify-content-center">
                <div class="col-md-7 text-center">
                    <span class="icon-question" style="font-size:60px; color:#f86f2d; display:block; margin-bottom:20px;"></span>
                    <h4 style="font-family:'Dosis',sans-serif;">No queries submitted yet</h4>
                    <p style="color:gray;">Have a question? Submit a query and our team will reply shortly.</p>
                    <a href="@Url.Action("HelpCentre", "Home")" class="btn btn-primary py-3 px-5 mt-3">Submit a Query</a>
                </div>
            </div>
        }
    </div>
</section>
