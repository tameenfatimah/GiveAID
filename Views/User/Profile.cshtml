@model GiveAID.Models.User
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Profile";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_3.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center">
                <p class="breadcrumbs"><span class="mr-2"><a href="@Url.Action("Index", "Home")">Home</a></span><span>My Profile</span></p>
                <h1 class="mb-3 bread">My Profile</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">

        @if (ViewBag.Success != null)
        {
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="alert alert-success">@ViewBag.Success</div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-md-5 ftco-animate">
                <div class="row justify-content-center mb-4">
                    <div class="col-md-12 heading-section">
                        <span class="subheading">Your Account</span>
                        <h2 class="mb-4">Profile Details</h2>
                    </div>
                </div>

                <table class="table">
                    <tr>
                        <td style="color:#f86f2d; font-weight:600; width:40%;">Full Name</td>
                        <td>@Model.Name</td>
                    </tr>
                    <tr>
                        <td style="color:#f86f2d; font-weight:600;">Email</td>
                        <td>@Model.Email</td>
                    </tr>
                    <tr>
                        <td style="color:#f86f2d; font-weight:600;">Phone</td>
                        <td>@Model.Phone</td>
                    </tr>
                    <tr>
                        <td style="color:#f86f2d; font-weight:600;">Address</td>
                        <td>@(string.IsNullOrEmpty(Model.Address) ? "Not provided" : Model.Address)</td>
                    </tr>
                    <tr>
                        <td style="color:#f86f2d; font-weight:600;">Profession</td>
                        <td>@(string.IsNullOrEmpty(Model.Profession) ? "Not provided" : Model.Profession)</td>
                    </tr>
                    <tr>
                        <td style="color:#f86f2d; font-weight:600;">Member Since</td>
                        <td>@Model.RegisteredAt.ToString("dd MMM yyyy")</td>
                    </tr>
                    <tr>
                        <td style="color:#f86f2d; font-weight:600;">Role</td>
                        <td>@Model.Role</td>
                    </tr>
                </table>

                <div class="mt-4">
                    <a href="@Url.Action("EditProfile", "User")" class="btn btn-primary py-3 px-4 mr-2">Edit Profile</a>
                    <a href="@Url.Action("ChangePassword", "User")" class="btn btn-outline-primary py-3 px-4">Change Password</a>
                </div>
            </div>

            <div class="col-md-7 pl-md-5 ftco-animate">
                <div class="row justify-content-center mb-4">
                    <div class="col-md-12 heading-section">
                        <span class="subheading">Your Contributions</span>
                        <h2 class="mb-4">Donation History</h2>
                    </div>
                </div>

                @{
                    var donations = ViewBag.Donations as List<GiveAID.Models.Donation>;
                }

                @if (donations != null && donations.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr style="color:#f86f2d; font-family:'Dosis',sans-serif;">
                                    <th>#</th>
                                    <th>Amount</th>
                                    <th>Cause</th>
                                    <th>Card Type</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int count = 1;
                                }
                                @foreach (var d in donations)
                                {
                                    <tr>
                                        <td>@count</td>
                                        <td style="color:#f86f2d; font-weight:600;">Rs.@d.Amount</td>
                                        <td>@d.Cause</td>
                                        <td>@d.CardType</td>
                                        <td>@d.DonationDate.ToString("dd MMM yyyy")</td>
                                    </tr>
                                    count++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p>You have not made any donations yet.</p>
                    <a href="@Url.Action("Index", "Donation")" class="btn btn-primary py-3 px-5">Donate Now</a>
                }
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-md-12 ftco-animate">
                <hr />
                <p class="mt-3">
                    <a href="@Url.Action("MyQueries", "User")" class="btn btn-outline-primary py-2 px-4 mr-2">My Queries</a>
                    <a href="@Url.Action("InviteFriend", "User")" class="btn btn-outline-primary py-2 px-4 mr-2">Invite a Friend</a>
                    <a href="@Url.Action("Logout", "User")" class="btn btn-outline-danger py-2 px-4">Logout</a>
                </p>
            </div>
        </div>

    </div>
</section>