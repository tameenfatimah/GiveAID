@{
    Layout = "_Layout";
    ViewData["Title"] = "Invite a Friend";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_6.jpg")');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-7 ftco-animate text-center">
                <p class="breadcrumbs"><span class="mr-2"><a href="@Url.Action("Index", "Home")">Home</a></span><span>Invite a Friend</span></p>
                <h1 class="mb-3 bread">Invite a Friend</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section">
    <div class="container">
        <div class="row">
            <div class="col-md-6 pr-md-5 ftco-animate">
                <div class="heading-section mb-5">
                    <span class="subheading">Spread the Word</span>
                    <h2 class="mb-3">Invite Someone to Give-AID</h2>
                    <p>Know someone who wants to make a difference? Send them an invitation.</p>
                </div>

                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success">@ViewBag.Success</div>
                }
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form method="post" action="@Url.Action("InviteFriend","User")">
                    <div class="form-group">
                        <input type="text" name="friendName" class="form-control" placeholder="Friend's Name (e.g. Ahmed Khan)" />
                    </div>
                    <div class="form-group">
                        <input type="email" name="friendEmail" class="form-control" placeholder="Friend's Email Address *" required />
                    </div>
                    <div class="form-group mt-2">
                        <input type="submit" value="Send Invitation" class="btn btn-primary py-3 px-5" />
                    </div>
                    <p class="mt-3"><a href="@Url.Action("Index", "Home")" style="color:#f86f2d;">&larr; Back to Home</a></p>
                </form>
            </div>

            <div class="col-md-6 ftco-animate">
                <div class="heading-section mb-4">
                    <span class="subheading">Why Invite?</span>
                    <h2 class="mb-3">Together We Do More</h2>
                </div>
                <div class="d-flex mb-4">
                    <div class="mr-4">
                        <span class="icon-child" style="font-size:40px; color:#f86f2d;"></span>
                    </div>
                    <div>
                        <h5 style="font-family:'Dosis',sans-serif;">Help More Children</h5>
                        <p>Every new member means more donations reach children in need.</p>
                    </div>
                </div>
                <div class="d-flex mb-4">
                    <div class="mr-4">
                        <span class="icon-paper-plane" style="font-size:40px; color:#f86f2d;"></span>
                    </div>
                    <div>
                        <h5 style="font-family:'Dosis',sans-serif;">Grow the Community</h5>
                        <p>A bigger community means a bigger impact across all our causes.</p>
                    </div>
                </div>
                <div class="d-flex mb-4">
                    <div class="mr-4">
                        <span class="icon-heart" style="font-size:40px; color:#f86f2d;"></span>
                    </div>
                    <div>
                        <h5 style="font-family:'Dosis',sans-serif;">Spread Kindness</h5>
                        <p>One invitation could inspire someone to change a life forever.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>