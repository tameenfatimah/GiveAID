<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GiveAID</title>

    <!-- Google Fonts -->
    @* <link href="https://fonts.googleapis.com/css?family=Dosis:200,300,400,500,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Overpass:300,400,400i,600,700" rel="stylesheet"> *@

    <!-- CSS -->
    <link rel="stylesheet" href="@Url.Content("~/css/open-iconic-bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/animate.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/owl.carousel.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/owl.theme.default.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/magnific-popup.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/aos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/ionicons.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/bootstrap-datepicker.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/jquery.timepicker.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/flaticon.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/icomoon.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/style.css")" />
</head>
<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var loggedInUser = Context.Session.GetString("UserName");
        var loggedInRole = Context.Session.GetString("UserRole");
    }

    <nav class="navbar navbar-expand-lg navbar-dark ftco_navbar ftco-navbar-light"
         id="ftco-navbar">
        <div class="container">

            <a class="navbar-brand" href="@Url.Action("Index", "Home")">Give-AID</a>

            <button class="navbar-toggler" type="button"
                    data-toggle="collapse"
                    data-target="#ftco-nav"
                    aria-controls="ftco-nav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="oi oi-menu"></span> Menu
            </button>

            <div class="collapse navbar-collapse" id="ftco-nav">
                <ul class="navbar-nav ml-auto">

                    <li class="nav-item @(currentAction == "Index" && currentController == "Home" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">Home</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown">About</a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="@Url.Action("About", "Home")">Read About Us</a>
                            <a class="dropdown-item" href="@Url.Action("WhatWeDo", "Home")">What We Do</a>
                            <a class="dropdown-item" href="@Url.Action("OurMission", "Home")">Our Mission</a>
                            <a class="dropdown-item" href="@Url.Action("OurTeam", "Home")">Our Team</a>
                            <a class="dropdown-item" href="@Url.Action("Partners", "Home")">Partners</a>
                            <a class="dropdown-item" href="@Url.Action("Career", "Home")">Career With Us</a>
                            <a class="dropdown-item" href="@Url.Action("Achievements", "Home")">Our Achievements</a>
                            <a class="dropdown-item" href="@Url.Action("OurSupporters", "Home")">Our Supporters</a>
                        </div>
                    </li>

                    <li class="nav-item @(currentAction == "NGOs" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("NGOs", "Home")">Causes</a>
                    </li>

                    <li class="nav-item @(currentController == "Donation" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("Index", "Donation")">Donate</a>
                    </li>

                    <li class="nav-item @(currentAction == "Gallery" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("Gallery", "Home")">Gallery</a>
                    </li>

                    <li class="nav-item @(currentAction == "Events" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("Events", "Home")">Events</a>
                    </li>

                    <li class="nav-item @(currentAction == "Contact" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("Contact", "Home")">Contact</a>
                    </li>

                    <li class="nav-item @(currentAction == "HelpCentre" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("HelpCentre", "Home")">Help</a>
                    </li>

                    @if (loggedInUser == null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Register", "User")">Register</a>
                        </li>
                        <li class="nav-item cta">
                            <a class="nav-link" href="@Url.Action("Login", "User")"><span>Login</span></a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown">
                                @loggedInUser
                            </a>
                            <div class="dropdown-menu dropdown-menu-right">
                                <a class="dropdown-item" href="@Url.Action("Profile", "User")">My Profile</a>
                                <a class="dropdown-item" href="@Url.Action("MyQueries", "User")">My Queries</a>
                                <a class="dropdown-item" href="@Url.Action("InviteFriends", "User")">Invite Friend</a>
                                @if (loggedInRole == "Admin")
                                {
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" href="@Url.Action("Dashboard", "Admin")">Admin Dashboard</a>
                                }
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-danger" href="@Url.Action("Logout", "User")">Logout</a>
                            </div>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()

    <!-- FOOTER -->
    <footer class="ftco-footer ftco-section img">
        <div class="overlay"></div>
        <div class="container">
            <div class="row mb-5">
                <div class="col-md-3">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2">About Give-AID</h2>
                        <p>Connecting generous donors with verified NGOs to make a real difference in the world.</p>
                        <ul class="ftco-footer-social list-unstyled float-md-left float-lft mt-5">
                            <li class="ftco-animate"><a href="#"><span class="icon-twitter"></span></a></li>
                            <li class="ftco-animate"><a href="#"><span class="icon-facebook"></span></a></li>
                            <li class="ftco-animate"><a href="#"><span class="icon-instagram"></span></a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2">Site Links</h2>
                        <ul class="list-unstyled">
                            <li><a href="@Url.Action("Index", "Home")" class="py-2 d-block">Home</a></li>
                            <li><a href="@Url.Action("About", "Home")" class="py-2 d-block">About</a></li>
                            <li><a href="@Url.Action("Index", "Donation")" class="py-2 d-block">Donate</a></li>
                            <li><a href="@Url.Action("Events", "Home")" class="py-2 d-block">Events</a></li>
                            <li><a href="@Url.Action("Gallery", "Home")" class="py-2 d-block">Gallery</a></li>
                            <li><a href="@Url.Action("Contact", "Home")" class="py-2 d-block">Contact</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2">Quick Links</h2>
                        <ul class="list-unstyled">
                            <li><a href="@Url.Action("HelpCentre", "Home")" class="py-2 d-block">Help Centre</a></li>
                            <li><a href="@Url.Action("Partners", "Home")" class="py-2 d-block">Partners</a></li>
                            <li><a href="@Url.Action("NGOs", "Home")" class="py-2 d-block">Our Causes</a></li>
                            <li><a href="@Url.Action("Register", "User")" class="py-2 d-block">Register</a></li>
                            <li><a href="@Url.Action("Login", "User")" class="py-2 d-block">Login</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2">Have a Question?</h2>
                        <div class="block-23 mb-3">
                            <ul>
                                <li><span class="icon icon-map-marker"></span><span class="text">Office 203, Welfare Street Clifton Block 5 Karachi Pakistan</span></li>
                                <li><a href="#"><span class="icon icon-phone"></span><span class="text">+92 21 3748 5962</span></a></li>
                                <li><a href="mailto:giveaidproject2026@gmail.com"><span class="icon icon-envelope"></span><span class="text">giveaidproject2026@gmail.com</span></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 text-center">
                    <p>Copyright &copy; @DateTime.Now.Year Give-AID. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Page Loader -->
    <div id="ftco-loader" class="show fullscreen">
        <svg class="circular" width="48px" height="48px">
            <circle class="path-bg" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke="#eeeeee" />
            <circle class="path" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke-miterlimit="10" stroke="#F96D00" />
        </svg>
    </div>

    <!-- JS -->
    <script src="@Url.Content("~/js/jquery.min.js")"></script>
    <script src="@Url.Content("~/js/jquery-migrate-3.0.1.min.js")"></script>
    <script src="@Url.Content("~/js/popper.min.js")"></script>
    <script src="@Url.Content("~/js/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.easing.1.3.js")"></script>
    <script src="@Url.Content("~/js/jquery.waypoints.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.stellar.min.js")"></script>
    <script src="@Url.Content("~/js/owl.carousel.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.magnific-popup.min.js")"></script>
    <script src="@Url.Content("~/js/aos.js")"></script>
    <script src="@Url.Content("~/js/jquery.animateNumber.min.js")"></script>
    <script src="@Url.Content("~/js/bootstrap-datepicker.js")"></script>
    <script src="@Url.Content("~/js/jquery.timepicker.min.js")"></script>
    <script src="@Url.Content("~/js/scrollax.min.js")"></script>
    <script src="@Url.Content("~/js/main.js")"></script>

</body>
</html>
